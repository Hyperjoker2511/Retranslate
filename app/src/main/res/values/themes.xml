<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain platform theme: all real theming is Jetpack Compose Material 3
         (ui/theme). This only covers the window before Compose takes over. -->
    <style name="Theme.ReTranslate" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcher_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
